  },
  "operations": {
    "subscribe-trades": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/trades"
      },
      "title": "Subscribe Trades Stream",
      "messages": [
        {
          "$ref": "#/channels/trades/messages/subscribe"
        }
      ]
    },
    "receive-trades": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/trades"
      },
      "title": "Trades Stream frames",
      "messages": [
        {
          "$ref": "#/channels/trades/messages/ack"
        },
        {
          "$ref": "#/channels/trades/messages/trade"
        }
      ]
    },
    "subscribe-token-updates": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/token-updates"
      },
      "title": "Subscribe Token Updates Stream",
      "messages": [
        {
          "$ref": "#/channels/token-updates/messages/subscribe"
        }
      ]
    },
    "receive-token-updates": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/token-updates"
      },
      "title": "Token Updates Stream frames",
      "messages": [
        {
          "$ref": "#/channels/token-updates/messages/ack"
        },
        {
          "$ref": "#/channels/token-updates/messages/update"
        }
      ]
    },
