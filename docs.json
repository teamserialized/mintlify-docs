    "primary": "#3D74FF",
    "light": "#3D74FF",
    "dark": "#1D4ED8"
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "prefill": true
    }
  },
